from __future__ import annotations

import re
import sqlite3
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

from .agents import KO_TO_SCHEMA, TOKEN_PATTERN
from .model_client import ChatModel, ModelClientError
from .models import DatabaseSchema, LinkingResult


@dataclass
class SQLAgentEvent:
    agent: str
    status: str
    details: dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> dict[str, Any]:
        return {"agent": self.agent, "status": self.status, **self.details}


@dataclass
class ExecutionResult:
    success: bool
    columns: list[str] = field(default_factory=list)
    rows: list[list[Any]] = field(default_factory=list)
    error: str | None = None

    def to_dict(self) -> dict[str, Any]:
        return {
            "success": self.success,
            "columns": self.columns,
            "rows": self.rows,
            "error": self.error,
        }


@dataclass
class SQLGenerationResult:
    sql: str
    success: bool
    attempts: int
    execution: ExecutionResult
    trace: list[SQLAgentEvent]

    def to_dict(self, include_trace: bool = False) -> dict[str, Any]:
        result: dict[str, Any] = {
            "sql": self.sql,
            "success": self.success,
            "attempts": self.attempts,
            "execution": self.execution.to_dict(),
        }
        if include_trace:
            result["agent_trace"] = [event.to_dict() for event in self.trace]
        return result


class SQLDrafterAgent:
    name = "sql_drafter"

    def __init__(self, model: ChatModel | None) -> None:
        self.model = model

    def draft(
        self, question: str, schema: DatabaseSchema, linking: LinkingResult
    ) -> tuple[str, SQLAgentEvent]:
        if self.model is not None:
            try:
                response = self.model.complete(
                    "You generate one SQLite SELECT query. Output SQL only, without explanation.",
                    generation_prompt(question, schema, linking),
                )
                sql = extract_sql(response)
                return sql, SQLAgentEvent(
                    self.name,
                    "ok",
                    {"mode": "model", "model": self.model.model, "sql": sql},
                )
            except (ModelClientError, ValueError) as error:
                sql = heuristic_sql(question, schema, linking)
                return sql, SQLAgentEvent(
                    self.name,
                    "fallback",
                    {"mode": "heuristic", "model_error": str(error), "sql": sql},
                )
        sql = heuristic_sql(question, schema, linking)
        return sql, SQLAgentEvent(
            self.name, "ok", {"mode": "heuristic", "sql": sql}
        )


class SQLCriticAgent:
    name = "sql_critic"

    def review(
        self, sql: str, schema: DatabaseSchema, linking: LinkingResult
    ) -> SQLAgentEvent:
        issues: list[str] = []
        safety_error = safe_select_error(sql)
        if safety_error:
            issues.append(safety_error)
        lower_sql = sql.lower()
        known_tables = {table.lower() for table in schema.tables}
        mentioned_tables = {
            table
            for table in known_tables
            if re.search(
                rf"(?<![0-9a-z_]){re.escape(table)}(?![0-9a-z_])", lower_sql
            )
        }
        if not mentioned_tables:
            issues.append("SQL에 알려진 테이블이 없음")
        selected = {table.lower() for table in linking.tables}
        outside = mentioned_tables - selected
        if outside:
            issues.append(f"schema linker 후보 밖 테이블 사용: {sorted(outside)}")
        return SQLAgentEvent(
            self.name,
            "ok" if not issues else "warning",
            {"valid": not issues, "issues": issues},
        )


class SQLiteExecutorAgent:
    name = "sqlite_executor"

    def __init__(self, preview_rows: int = 5, progress_limit: int = 20_000) -> None:
        self.preview_rows = preview_rows
        self.progress_limit = progress_limit

    def execute(self, sql: str, database_path: Path) -> ExecutionResult:
        safety_error = safe_select_error(sql)
        if safety_error:
            return ExecutionResult(False, error=safety_error)
        if not database_path.is_file():
            return ExecutionResult(False, error=f"database not found: {database_path}")

        connection: sqlite3.Connection | None = None
        try:
            connection = sqlite3.connect(
                f"file:{database_path.resolve()}?mode=ro", uri=True, timeout=5.0
            )
            connection.execute("PRAGMA query_only = ON")
            calls = 0

            def guard() -> int:
                nonlocal calls
                calls += 1
                return int(calls > self.progress_limit)

            connection.set_progress_handler(guard, 1_000)
            cursor = connection.execute(sql)
            columns = [description[0] for description in cursor.description or []]
            rows = [list(row) for row in cursor.fetchmany(self.preview_rows)]
            return ExecutionResult(True, columns=columns, rows=rows)
        except sqlite3.Error as error:
            return ExecutionResult(False, error=str(error))
        finally:
            if connection is not None:
                connection.close()


class SQLRepairAgent:
    name = "sql_repair"

    def __init__(self, model: ChatModel | None) -> None:
        self.model = model

    def repair(
        self,
        question: str,
        schema: DatabaseSchema,
        linking: LinkingResult,
        sql: str,
        error: str,
    ) -> tuple[str, SQLAgentEvent]:
        if self.model is not None:
            prompt = (
                f"{generation_prompt(question, schema, linking)}\n\n"
                f"Failed SQL:\n{sql}\n\nSQLite error:\n{error}\n\n"
                "Return corrected SQL only."
            )
            try:
                response = self.model.complete(
                    "Repair the SQLite SELECT query using the error. Output SQL only.",
                    prompt,
                )
                repaired = extract_sql(response)
                return repaired, SQLAgentEvent(
                    self.name,
                    "ok",
                    {"mode": "model", "model": self.model.model, "sql": repaired},
                )
            except (ModelClientError, ValueError) as model_error:
                error = f"{error}; model_error={model_error}"

        repaired = safe_fallback_sql(question, linking)
        return repaired, SQLAgentEvent(
            self.name,
            "fallback",
            {"mode": "heuristic", "reason": error, "sql": repaired},
        )


def extract_sql(response: str) -> str:
    fenced = re.search(r"```(?:sql)?\s*(.*?)```", response, flags=re.I | re.S)
    candidate = fenced.group(1) if fenced else response
    match = re.search(r"\b(?:SELECT|WITH)\b.*", candidate.strip(), flags=re.I | re.S)
    if not match:
        raise ValueError("model response에 SELECT/WITH SQL이 없음")
    sql = match.group(0).strip()
    if sql.endswith(";"):
        sql = sql[:-1].rstrip()
    error = safe_select_error(sql)
    if error:
        raise ValueError(error)
    return sql


def safe_select_error(sql: str) -> str | None:
    stripped = sql.strip()
    if not stripped:
        return "빈 SQL"
    without_trailing = stripped[:-1] if stripped.endswith(";") else stripped
    if ";" in without_trailing:
        return "여러 SQL statement는 허용하지 않음"
    if not re.match(r"^(SELECT|WITH)\b", without_trailing, flags=re.I):
        return "SELECT 또는 WITH query만 허용"
    banned = re.search(
        r"\b(INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|ATTACH|DETACH|PRAGMA|REINDEX|VACUUM)\b",
        without_trailing,
        flags=re.I,
    )
    if banned:
        return f"금지된 SQL keyword: {banned.group(1).upper()}"
    return None


def generation_prompt(
    question: str, schema: DatabaseSchema, linking: LinkingResult
) -> str:
    selected_tables = set(linking.tables)
    selected_columns = set(linking.columns)
    schema_lines: list[str] = []
    for table in linking.tables:
        rendered = ", ".join(
            f"{quote_identifier(column.name)} {column.column_type}"
            for column in schema.columns_for(table)
            if column.key in selected_columns
        )
        schema_lines.append(
            f"TABLE {quote_identifier(table)} ({rendered or '<no selected columns>'})"
        )
    foreign_keys = [
        f"{left} = {right}"
        for left, right in schema.foreign_keys
        if left.split(".", 1)[0] in selected_tables
        and right.split(".", 1)[0] in selected_tables
        and left in selected_columns
        and right in selected_columns
    ]
    return (
        f"Korean question: {question}\n"
        f"Database id: {schema.db_id}\n"
        f"Retrieved schema:\n" + "\n".join(schema_lines) + "\n"
        f"Foreign keys: {foreign_keys or 'none'}\n"
        "Rules: use SQLite syntax; use only the retrieved schema; produce one read-only query."
    )


def heuristic_sql(
    question: str, schema: DatabaseSchema, linking: LinkingResult
) -> str:
    table = linking.tables[0]
    lower = question.lower()
    if any(cue in lower for cue in ("몇 명", "몇 개", "개수", "총 수", "총 인원")):
        return f"SELECT COUNT(*) FROM {quote_identifier(table)}"

    selected_columns = question_columns(question, schema, linking, table)
    aggregate = aggregate_function(lower)
    if aggregate and selected_columns:
        expression = f"{aggregate}({quote_identifier(selected_columns[0])})"
    elif selected_columns:
        expression = ", ".join(
            quote_identifier(column) for column in selected_columns[:4]
        )
    else:
        expression = "*"
    sql = f"SELECT {expression} FROM {quote_identifier(table)}"
    if not aggregate and selected_columns and "순서" in lower:
        order_column = ordering_column(selected_columns, schema, table)
        direction = "DESC" if any(
            cue in lower for cue in ("많은", "높은", "큰", "내림", "오래된", "늙")
        ) else "ASC"
        sql += f" ORDER BY {quote_identifier(order_column)} {direction}"
    return sql


def safe_fallback_sql(question: str, linking: LinkingResult) -> str:
    table = linking.tables[0]
    if any(cue in question for cue in ("몇 명", "몇 개", "개수", "총 수", "총 인원")):
        return f"SELECT COUNT(*) FROM {quote_identifier(table)}"
    return f"SELECT * FROM {quote_identifier(table)}"


def question_columns(
    question: str, schema: DatabaseSchema, linking: LinkingResult, table: str
) -> list[str]:
    concepts = set(TOKEN_PATTERN.findall(question.lower()))
    for korean, english in KO_TO_SCHEMA.items():
        if korean in question:
            concepts.update(english)
    candidates: list[tuple[float, str]] = []
    for key in linking.columns:
        column = schema.column(key)
        if column is None or column.table != table or key in schema.primary_keys:
            continue
        tokens = set(TOKEN_PATTERN.findall(column.name.lower().replace("_", " ")))
        score = len(tokens & concepts) / len(tokens)
        if score:
            candidates.append((float(score), column.name))
    if not candidates:
        return []
    best_score = max(score for score, _ in candidates)
    filtered = [item for item in candidates if item[0] >= best_score * 0.75]
    return [name for _, name in sorted(filtered, key=lambda item: (-item[0], item[1]))]


def aggregate_function(question: str) -> str | None:
    if "평균" in question:
        return "AVG"
    if any(cue in question for cue in ("최고", "가장 큰", "최대")):
        return "MAX"
    if any(cue in question for cue in ("최저", "가장 작은", "최소")):
        return "MIN"
    if "합계" in question:
        return "SUM"
    return None


def ordering_column(
    columns: list[str], schema: DatabaseSchema, table: str
) -> str:
    numeric = {
        column.name
        for column in schema.columns_for(table)
        if column.column_type in {"number", "time"}
    }
    return next((column for column in columns if column in numeric), columns[0])


def quote_identifier(identifier: str) -> str:
    return '"' + identifier.replace('"', '""') + '"'
